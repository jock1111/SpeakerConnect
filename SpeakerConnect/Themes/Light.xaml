<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Windows 11-style light theme brushes. Same keys as Dark.xaml. -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F3F5F7" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardHoverBackgroundBrush" Color="#F7F8FA" />
    <SolidColorBrush x:Key="SubtleBackgroundBrush" Color="#F7F8FA" />
    <SolidColorBrush x:Key="NavBackgroundBrush" Color="#EBEDF0" />
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="#E2E5EA" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TrackBackgroundBrush" Color="#E1E5E9" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="#E1E5E9" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5D5D5D" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6E6E6E" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <!-- Accent and interaction -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1975C5" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#005A9E" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#D6E8F7" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#EDEFF2" />
    <SolidColorBrush x:Key="PressedBackgroundBrush" Color="#E2E5EA" />
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#D6E8F7" />
    <SolidColorBrush x:Key="FocusBorderBrush" Color="#0067C0" />

    <!-- Button chrome -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="#F0F2F5" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="#E4E7EB" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#D1D5DB" />

    <!-- Status -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#107C10" />
    <SolidColorBrush x:Key="WarningBrush" Color="#9D5D00" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="ErrorSubtleBrush" Color="#FDE7E9" />
    <SolidColorBrush x:Key="InfoBrush" Color="#0067C0" />

    <!-- Slider -->
    <SolidColorBrush x:Key="SliderThumbBrush" Color="#FFFFFF" />

    <!-- Badges -->
    <SolidColorBrush x:Key="BadgeSourceBackgroundBrush" Color="#D6E8F7" />
    <SolidColorBrush x:Key="BadgeSourceTextBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="BadgeOutputBackgroundBrush" Color="#DFF6DD" />
    <SolidColorBrush x:Key="BadgeOutputTextBrush" Color="#107C10" />
    <SolidColorBrush x:Key="BadgeReferenceBackgroundBrush" Color="#FFF4CE" />
    <SolidColorBrush x:Key="BadgeReferenceTextBrush" Color="#9D5D00" />
    <SolidColorBrush x:Key="BadgeNeutralBackgroundBrush" Color="#EDEFF2" />
    <SolidColorBrush x:Key="BadgeNeutralTextBrush" Color="#5D5D5D" />

    <!-- Disabled -->
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#A0A0A0" />
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#F0F0F0" />
</ResourceDictionary>
