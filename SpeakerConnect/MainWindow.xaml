<Window x:Class="SpeakerConnect.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:SpeakerConnect.Views"
        mc:Ignorable="d"
        Title="Speaker Connect"
        Height="800"
        Width="1280"
        MinHeight="660"
        MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        Background="{DynamicResource PageBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ======================= Sidebar ======================= -->
        <Border Grid.Column="0"
                Background="{DynamicResource NavBackgroundBrush}"
                BorderBrush="{DynamicResource SeparatorBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title -->
                <StackPanel Grid.Row="0" Margin="20,22,20,18">
                    <TextBlock Text="Speaker Connect"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Multi-speaker audio router"
                               FontSize="12"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>

                <!-- Navigation -->
                <ListBox Grid.Row="1"
                         Style="{StaticResource NavListBox}"
                         ItemContainerStyle="{StaticResource NavListBoxItem}"
                         ItemsSource="{Binding Pages}"
                         SelectedValuePath="Page"
                         SelectedValue="{Binding CurrentPage, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Footer: status + theme -->
                <StackPanel Grid.Row="2" Margin="16,0,16,16">
                    <Border Background="{DynamicResource SeparatorBrush}" Height="1" Margin="4,0,4,14" />
                    <Grid Margin="4,0,4,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{Binding IsRunning, Converter={StaticResource RunningToBrush}}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding IsRunning, Converter={StaticResource RunningStateText}}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Theme" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  Margin="10,0,0,0"
                                  ItemsSource="{Binding ThemeModes}"
                                  SelectedItem="{Binding Theme, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================= Content ======================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Slim status strip visible on every page -->
            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource SeparatorBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="28,10">
                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               FontSize="12"
                               Foreground="{DynamicResource ErrorBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,2,0,0"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <views:DashboardView Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Dashboard}" />
                <views:SyncView Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Synchronization}" />
                <views:BalanceView Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=VolumeBalance}" />
                <views:SettingsView Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Settings}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
