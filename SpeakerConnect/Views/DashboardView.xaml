<UserControl x:Class="SpeakerConnect.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- Speaker card template shared by the dashboard list -->
        <DataTemplate x:Key="SpeakerCardTemplate">
            <Border Style="{StaticResource CardBorder}"
                    Margin="0,0,0,12"
                    Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header: select, name, badges, reference -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0"
                                  VerticalAlignment="Top"
                                  Margin="0,2,0,0"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding CanSelect}"
                                  ToolTip="Route a copy of the loopback audio to this speaker" />

                        <StackPanel Grid.Column="1" Margin="12,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <Border Style="{StaticResource BadgeBorder}"
                                        Background="{DynamicResource BadgeSourceBackgroundBrush}"
                                        Visibility="{Binding ShowSourceBadge, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Source" Style="{StaticResource BadgeText}"
                                               Foreground="{DynamicResource BadgeSourceTextBrush}" />
                                </Border>
                                <Border Style="{StaticResource BadgeBorder}"
                                        Background="{DynamicResource BadgeOutputBackgroundBrush}"
                                        Visibility="{Binding ShowOutputBadge, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Output" Style="{StaticResource BadgeText}"
                                               Foreground="{DynamicResource BadgeOutputTextBrush}" />
                                </Border>
                                <Border Style="{StaticResource BadgeBorder}"
                                        Background="{DynamicResource BadgeReferenceBackgroundBrush}"
                                        Visibility="{Binding ShowReferenceBadge, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Reference" Style="{StaticResource BadgeText}"
                                               Foreground="{DynamicResource BadgeReferenceTextBrush}" />
                                </Border>
                                <Border Style="{StaticResource BadgeBorder}"
                                        Background="{DynamicResource BadgeNeutralBackgroundBrush}"
                                        Visibility="{Binding ShowBluetoothBadge, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Bluetooth?" Style="{StaticResource BadgeText}"
                                               Foreground="{DynamicResource BadgeNeutralTextBrush}" />
                                </Border>
                                <Border Style="{StaticResource BadgeBorder}"
                                        Background="{DynamicResource BadgeNeutralBackgroundBrush}"
                                        Visibility="{Binding ShowDefaultBadge, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Default" Style="{StaticResource BadgeText}"
                                               Foreground="{DynamicResource BadgeNeutralTextBrush}" />
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{Binding Details}"
                                       Style="{StaticResource CaptionText}"
                                       Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding RoleLabel}"
                                       FontSize="12"
                                       Foreground="{DynamicResource InfoBrush}"
                                       Margin="0,3,0,0"
                                       Visibility="{Binding RoleLabel, Converter={StaticResource StringToVisibility}}" />
                            <TextBlock Text="{Binding RuntimeStatus}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SyncMeasurementText}"
                                       FontSize="12"
                                       Foreground="{DynamicResource WarningBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0"
                                       Visibility="{Binding HasSyncMeasurement, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                Content="Ref"
                                MinWidth="44"
                                Padding="10,5"
                                FontSize="12"
                                Command="{Binding DataContext.SetReferenceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding IsControlEnabled}"
                                ToolTip="Set as the sync reference speaker" />
                    </Grid>

                    <!-- Controls: volume + delay -->
                    <Grid Grid.Row="1" Margin="30,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="160" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" MinWidth="160" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Grid>
                                <TextBlock Text="Volume" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding VolumeText}" Style="{StaticResource CaptionText}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Minimum="0" Maximum="100"
                                    TickFrequency="5" SmallChange="1" LargeChange="10"
                                    Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding IsControlEnabled}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Grid>
                                <TextBlock Text="Delay" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding DelayText}" Style="{StaticResource CaptionText}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Minimum="0" Maximum="2000"
                                    TickFrequency="10" SmallChange="5" LargeChange="50"
                                    Value="{Binding DelayMilliseconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding CanAdjustDelay}"
                                    ToolTip="Additional delay applied to this speaker's copy (0–2000 ms)" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,20,28,28">

            <!-- Page header -->
            <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Mirror Windows audio from one playback endpoint to up to four additional speakers."
                       Style="{StaticResource BodyText}"
                       Margin="0,4,0,0" />

            <!-- Routing status hero -->
            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                     Fill="{Binding IsRunning, Converter={StaticResource RunningToBrush}}" />
                            <TextBlock Text="{Binding IsRunning, Converter={StaticResource RunningStateText}}"
                                       Style="{StaticResource CardTitle}"
                                       FontSize="17"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding EndpointSummary}"
                                   Style="{StaticResource CaptionText}"
                                   Margin="20,6,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Start routing"
                                Style="{StaticResource TransportButton}"
                                Command="{Binding StartCommand}"
                                Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVisibility}}" />
                        <Button Content="Stop"
                                Style="{StaticResource TransportButton}"
                                Command="{Binding StopCommand}"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Master volume card -->
            <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Master volume"
                               Style="{StaticResource CardTitle}"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Margin="24,0,24,0" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="Group volume applied to every speaker"
                                       Style="{StaticResource CaptionText}" />
                            <TextBlock Text="{Binding MasterVolume, StringFormat={}{0:0}%}"
                                       Style="{StaticResource ValueText}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                        <Slider Minimum="0" Maximum="100"
                                TickFrequency="10" SmallChange="1" LargeChange="10"
                                Value="{Binding MasterVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding IsRunning}" />
                    </StackPanel>

                    <ToggleButton Grid.Column="2"
                                  Content="{Binding MasterMute, Converter={StaticResource MuteTextConverter}}"
                                  IsChecked="{Binding MasterMute, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding IsRunning}"
                                  VerticalAlignment="Center"
                                  ToolTip="Mute all routed speakers" />
                </Grid>
            </Border>

            <!-- Loopback source card -->
            <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Loopback source" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Keeps playing natively through Windows"
                                       Style="{StaticResource CaptionText}"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <ComboBox Grid.Column="1"
                                  Margin="24,0,24,0"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding Devices}"
                                  SelectedItem="{Binding SourceDevice, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  IsEnabled="{Binding IsConfigurationEnabled}"
                                  ToolTip="The endpoint whose audio is mirrored to the other speakers" />

                        <Button Grid.Column="2"
                                Content="Use Bluetooth source"
                                Command="{Binding UseBluetoothSourceCommand}"
                                IsEnabled="{Binding IsConfigurationEnabled}"
                                VerticalAlignment="Center"
                                ToolTip="Preselects the Bluetooth-style endpoint as the loopback source (name-based hint)" />
                    </Grid>

                    <TextBlock Text="{Binding SourceSummary}"
                               Style="{StaticResource BodyText}"
                               Margin="0,10,0,0" />
                    <TextBlock Text="{Binding BluetoothHintText}"
                               Style="{StaticResource CaptionText}"
                               Margin="0,4,0,0"
                               Visibility="{Binding HasBluetoothHints, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- Speakers -->
            <Grid Margin="0,20,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Speakers" Style="{StaticResource SectionTitle}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding SelectionSummary}"
                           Style="{StaticResource CaptionText}"
                           VerticalAlignment="Bottom" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Devices}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Width" Value="520" />
                        <Setter Property="Margin" Value="0,0,16,0" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <StaticResource ResourceKey="SpeakerCardTemplate" />
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Up to four destinations can be checked; the source plus checked outputs must not exceed five audible endpoints."
                       Style="{StaticResource CaptionText}"
                       Margin="0,4,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
