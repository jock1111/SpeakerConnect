<UserControl x:Class="SpeakerConnect.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,20,28,28">

            <TextBlock Text="Settings &amp; Diagnostics" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Appearance, latency profile, and technical diagnostics."
                       Style="{StaticResource BodyText}"
                       Margin="0,4,0,0" />

            <!-- Appearance -->
            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Appearance" Style="{StaticResource CardTitle}" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Theme" Style="{StaticResource BodyText}"
                                   VerticalAlignment="Center" />

                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding ThemeModes}"
                                  SelectedItem="{Binding Theme, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  ToolTip="Dark, Light, or follow the Windows app theme" />

                        <TextBlock Grid.Column="2"
                                   Text="Dark is the default. System follows the Windows personalization setting."
                                   Style="{StaticResource CaptionText}"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Latency profile -->
            <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Latency profile" Style="{StaticResource CardTitle}" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Buffer profile" Style="{StaticResource BodyText}"
                                   VerticalAlignment="Center" />

                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding BufferProfiles}"
                                  SelectedItem="{Binding SelectedBufferProfile, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  IsEnabled="{Binding IsConfigurationEnabled}"
                                  VerticalAlignment="Center"
                                  ToolTip="Applies the next time routing is started" />

                        <TextBlock Grid.Column="2"
                                   Text="{Binding BufferProfileSummary}"
                                   Style="{StaticResource CaptionText}"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Diagnostics -->
            <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Routing diagnostics" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="{Binding SyncDiagnosticsSummary}"
                               Style="{StaticResource BodyText}"
                               Margin="0,8,0,0"
                               Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="Start routing to see live buffer, underrun, and drift statistics. These are software-side measurements; acoustic latency is not included."
                               Style="{StaticResource CaptionText}"
                               Margin="0,8,0,0"
                               Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVisibility}}" />

                    <ItemsControl ItemsSource="{Binding Devices}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SoftwareStatusLine}"
                                           FontSize="12"
                                           Foreground="{DynamicResource InfoBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,6"
                                           Visibility="{Binding HasSoftwareStatus, Converter={StaticResource BoolToVisibility}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Limitations -->
            <Expander Margin="0,12,0,0">
                <Expander.Header>
                    <TextBlock Text="How this works and what it cannot do"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </Expander.Header>
                <Border Style="{StaticResource CardBorder}" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyText}"
                                   Text="Speaker Connect captures the WASAPI loopback mix of the selected source endpoint. Windows continues to play the original audio to that endpoint; the application sends converted copies to up to four checked destinations. That is five audible endpoints total: the source plus four copies. The source cannot be its own destination because that would create a feedback loop." />
                        <TextBlock Style="{StaticResource BodyText}"
                                   Margin="0,10,0,0"
                                   Text="A loopback copy is not sample-accurate with the original playback. The pipeline has a base buffer for capture/render jitter and drift correction, plus endpoint hardware latency. Copies can be delayed relative to one another, but the original source cannot be delayed or advanced by this application. If the source is earlier than every copy, exact alignment with the source is impossible; the copies can only be aligned with each other. Bluetooth codec/transport latency adds another unknown offset. Use the per-device delay controls to delay the faster output path, not the slower one." />
                        <TextBlock Style="{StaticResource BodyText}"
                                   Margin="0,10,0,0"
                                   Text="Smart Volume Balance is relative matching, not calibrated SPL. It measures each speaker with the default microphone, which has unknown frequency response and absolute sensitivity; room position and background noise also affect the result. Re-run calibration after moving a speaker or changing its Windows endpoint volume. The source speaker is the special case: because loopback capture is taken before endpoint volume, its correction must be applied by lowering its Windows endpoint volume. If the source is also the Windows default, that correction becomes the maximum reachable slider position while balance is active; the app re-caps the endpoint above it so the balance is not lost. Stop routing or disable automatic balance to restore the full Windows range." />
                        <TextBlock Style="{StaticResource BodyText}"
                                   Margin="0,10,0,0"
                                   Text="Fully independent per-application routing to multiple endpoints is not possible with loopback alone. A proper solution needs a virtual audio endpoint architecture: an application (or virtual cable) renders into a virtual device, the router captures that endpoint's audio, and a clock-synchronised renderer fans out to up to four physical endpoints with independent volume, delay, and format conversion. Windows apps still choose a single output endpoint, so a virtual endpoint is required to intercept their audio before the physical device. This architecture is not implemented yet." />
                    </StackPanel>
                </Border>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
